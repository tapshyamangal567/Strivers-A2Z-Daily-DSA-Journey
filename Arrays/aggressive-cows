// Problem : aggressive cows
// Platform : TUF
// TC : O( nlog n + n log d)
// SC : O(1)

class Solution {
public:
    int canweplace(vector<int> &a , int dist , int cows ) {
         int cntcows = 1;
         int last = a[0];
         for(int i=0 ;i<a.size();i++) {
            if(a[i] - last >= dist) {
                cntcows++;
                last = a[i];
            }
            if(cntcows >= cows) return true;
         }
         return false;
    }
    int aggressiveCows(vector<int> &nums, int k) {
        int n = nums.size();
        sort(nums.begin(),nums.end());
        int low =0;
        int high= nums[n-1] - nums[0];
        while(low <= high) {
            int mid = (low + high)/2;
            if(canweplace(nums , mid ,k)) {
                low = mid +1;
            }
            else {
                high = mid -1;
            }
        }
        return high;
    } 
};
