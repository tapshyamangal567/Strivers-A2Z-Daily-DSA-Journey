// Problem : koko eating bananas
// Platform : leetcodde


class Solution {
public:
    int findmax(vector<int> &arr) {
        int maxi = INT_MIN;
        for(int i=0 ;i<arr.size();i++) {
            maxi = max(maxi , arr[i]);
        }
        return maxi;
    }
    int totalhours(vector<int> &v , int hourly) {
        int totalh =0;
        for(int i=0 ;i<v.size();i++) {
            totalh += ceil((double) v[i] / hourly);
        }
        return totalh;
    }
    int minEatingSpeed(vector<int>& piles, int h) {
        int low = 1 ;
        int high = findmax(piles);
        while(low <= high) {
            int mid = (low + high)/2;
            int totalhrs = totalhours(piles , mid);
            if(totalhrs <= h) {
                high = mid -1;
            }
            else {
                low = mid +1;
            }
        }
        return low;
    }
};
