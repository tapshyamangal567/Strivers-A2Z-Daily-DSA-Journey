// Problem : Given an integer numRows, return the first numRows of Pascal's triangle.
// Platform : Leetcode
// Difficulty : Medium


class Solution {
public:
   int ncr(int n , int r) {
       long long res =1;
       for(int i=0 ;i<r ;i++) {
        res = res *(n-i);
        res = res/(i+1);
       }
       return (int)res;
   }
    int pascalTriangleI(int r, int c) {
        return ncr(r-1 , c-1);

    }
};
