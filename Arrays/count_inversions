// Problem : Count inversions in an array 
// Difficulty : Hard
// Platform : TUF

class Solution {
public:

    // Merge function jo merge bhi karega aur inversions bhi count karega
    int merge(vector<int>& arr, int low, int mid, int high) {
        vector<int> temp;
        int left = low;
        int right = mid + 1;
        int cnt = 0;

        while (left <= mid && right <= high) {

            if (arr[left] <= arr[right]) {
                temp.push_back(arr[left]);
                left++;
            }
            else {
                temp.push_back(arr[right]);

                // Left half sorted hai, isliye left se mid tak
                // saare elements arr[right] se bade honge
                cnt += (mid - left + 1);

                right++;
            }
        }

        while (left <= mid) {
            temp.push_back(arr[left]);
            left++;
        }

        while (right <= high) {
            temp.push_back(arr[right]);
            right++;
        }

        // Original array me copy back
        for (int i = low; i <= high; i++) {
            arr[i] = temp[i - low];
        }

        return cnt;
    }

    // Merge Sort function
    int mergeSort(vector<int>& arr, int low, int high) {

        if (low >= high)
            return 0;

        int mid = (low + high) / 2;

        int cnt = 0;

        cnt += mergeSort(arr, low, mid);       // Left inversions
        cnt += mergeSort(arr, mid + 1, high);  // Right inversions
        cnt += merge(arr, low, mid, high);     // Cross inversions

        return cnt;
    }

    // Main function
    int inversionCount(vector<int>& arr) {
        return mergeSort(arr, 0, arr.size() - 1);
    }
};
