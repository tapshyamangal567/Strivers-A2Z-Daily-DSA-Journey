// Problem : count occurences of target in sorted array 
// Platform : TUF
// TC : O( log n ) 

class Solution {
public:
    int countOccurrences(vector<int>& arr, int target) {
      
        // First Occurrence
        int n = arr.size();
        int low = 0, high = n - 1;
        int first = -1;

        while (low <= high) {
            int mid = low + (high - low) / 2;

            if (arr[mid] == target) {
                first = mid;
                high = mid - 1;      // left side search
            }
            else if (arr[mid] < target) {
                low = mid + 1;
            }
            else {
                high = mid - 1;
            }
        }

        // Target not found
        if (first == -1) return 0;

        // Last Occurrence
        low = 0;
        high = n - 1;
        int last = -1;

        while (low <= high) {
            int mid = low + (high - low) / 2;

            if (arr[mid] == target) {
                last = mid;
                low = mid + 1;       // right side search
            }
            else if (arr[mid] < target) {
                low = mid + 1;
            }
            else {
                high = mid - 1;
            }
        }

        return last - first + 1;
    }
};
