// Problem : Given two integers r and c, return the value at the rth row and cth column (1-indexed) in a Pascal's Triangle
// Platform : TUF
// Difficulty : hard
// TC  IS O(n) and SC IS O(1) 

class Solution {
public:
   int ncr(int n , int r) {
       long long res =1;
       for(int i=0 ;i<r ;i++) {
        res = res *(n-i);
        res = res/(i+1);
       }
       return (int)res;
   }
    int pascalTriangleI(int r, int c) {
        return ncr(r-1 , c-1);

    }
};
