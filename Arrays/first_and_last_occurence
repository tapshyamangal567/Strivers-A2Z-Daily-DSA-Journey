// Problem : fins first and last occurence of element 
// Platform : leetcode
// Brute force with TC : O(n)

class Solution {
public:
    vector<int> searchRange(vector<int>& nums, int target) {
        int first = -1; 
        int last = -1;
        for(int i=0 ;i<nums.size();i++) {
            if(nums[i] == target) {
                if(first == -1 ) first =i;
                last =i;
            }
        }
        return {first , last};
    }
};

// Optimal with TC : O(log n ) 
class Solution {
public:
    vector<int> searchRange(vector<int>& nums, int target) {
        int n = nums.size();
        int first = -1;
        int low =0 , high = n-1;
    
        while(low <= high) {
            int mid = (low + high)/2;
            if(nums[mid] == target) {
                first = mid;
                high = mid -1;
            }
            else if(nums[mid] < target){
                low = mid +1;
            }
            else {
                high = mid -1;
            }
        }

         int last = -1;
         low =0 , high = n-1;
        while(low <= high) {
            int mid = (low + high)/2;
            if(nums[mid] == target) {
                last = mid;
                 low = mid +1;
            }
            else if(nums[mid] < target){
                low = mid +1;
            }
            else {
                high = mid -1;
            }
        }

        return {first , last};
    }
};
