class Solution {
  public:
    int maxLen(vector<int>& arr) {
        map<int , int>mpp;
        int maxlen =0;
        int sum =0;
         int n = arr.size();
         for(int i=0 ;i<n ;i++){
            sum += arr[i];

            if(sum ==0 ) {
                maxlen = i+1;
            }
                 if(mpp.find(sum) != mpp.end()) {
                    int len = i - mpp[sum];
                    maxlen = max(maxlen , len);
                 }
                 else {
                    mpp[sum] = i;
                 }

         }
       return maxlen;

    }
};
