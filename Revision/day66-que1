class Solution {
  public:
    int maxLen(vector<int>& arr) {
        int maxlen =0 
        long long sum =0;
        map<long long , int> mpp;
        int n = arr.size();
        for(int i=0 ;i<n ;i++) {
            sum += arr[i];

             if(sum == 0) {
              maxlen = i+1;
        }
        else if(mpp.find(sum) != mpp.end()) {
            maxlen = max(maxlen , i-mpp[sum]);
        }
        else {
            mpp[sum] = i;
        }
        }
       return maxlen;

    }
};
