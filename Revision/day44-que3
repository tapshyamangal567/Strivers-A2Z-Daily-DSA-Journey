class Solution {
public:
    int secondLargestElement(vector<int>& nums) {
        //your code goes here
        int s_largest = -1;
        int largest = nums[0];
        int n = nums.size();
        for(int i=0 ;i<n ;i++) {
            if(nums[i] > largest) {
                s_largest = largest;
                largest = nums[i];
            }
            else if(nums[i] < largest && nums[i] > s_largest) {
               s_largest = nums[i];
            } 
        }
        
      return s_largest;
    }
};
