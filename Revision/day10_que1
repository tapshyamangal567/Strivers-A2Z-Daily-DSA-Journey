// Problem : Count subarrays with given xor

class Solution{
public:
    int subarraysWithXorK(vector<int> &nums, int k) {
        int xr =0;
        int cnt =0;
        int n = nums.size();
        map<int,int> mpp;
        mpp[xr]++;
        for(int i=0 ;i<n;i++) {
            xr ^= nums[i];
            int x = xr ^k;
            cnt += mpp[x];
            mpp[xr]++;
        }
        return cnt;
    }
};
