class Solution{
public:
    int subarraysWithXorK(vector<int> &nums, int k) {
        int cnt =0;
        int xr =0;
        map<int ,int>mpp;
        mpp[xr]++;
        for(int i=0 ;i<nums.size();i++) {
            xr ^= nums[i];
            int x = xr ^ k;
            cnt += mpp[x];
            mpp[xr]++;
        }
        
        return cnt;
    }
};
