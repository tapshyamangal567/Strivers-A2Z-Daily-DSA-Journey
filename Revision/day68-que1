class Solution {
public:
    int subarraySum(vector<int>& nums, int k) {
        int cnt =0;
        int n = nums.size();
        map<int , int>mpp;
        int presum =0;
        mpp[0] = 1;
        for(int i=0 ;i<n ;i++) {
            presum += nums[i];
            int remove = presum -k;
            cnt += mpp[remove];
            mpp[presum]++;

        }

        return cnt ;
    }
};
