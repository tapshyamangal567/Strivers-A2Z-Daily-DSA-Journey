class Solution {
public:
    int secondLargestElement(vector<int>& nums) {
       int largest = nums[0];
       int s_largest= -1;
       int n = nums.size();
       for(int i=0 ;i<n ;i++) {
        if(nums[i] > largest) {
            s_largest= largest;
            largest= nums[i];
        }
        else if(nums[i] < largest && nums[i] > s_largest) {
            s_largest = nums[i];
        }
       }
       return s_largest;
    }
};
