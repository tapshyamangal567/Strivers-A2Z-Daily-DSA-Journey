class Solution {
public:
  int NthRoot(int N, int M) {
       int low =1 , high = M;
       long long power =1 ;
       while(low <= high) {
        int mid = (low + high)/2;
        for(int i=1 ;i<=N ;i++) {
            power *= mid;

            if(power > M) break;
        }
        if(power == M) return mid;
        else if(power < M) low = mid +1;
        else {
            high = mid-1;
       }
     return -1;
    }
};
