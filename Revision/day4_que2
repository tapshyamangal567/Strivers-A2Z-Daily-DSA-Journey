// Problem : leaders in an array

class Solution {
public:
    vector<int> leaders(vector<int>& nums) {
     vector<int> ans;
     int n = nums.size();
     int maxi = nums[n-1];
     ans.push_back(maxi);
     for(int i=n-2 ;i>=0;i--) {
        if(nums[i] > maxi) {
            ans.push_back(maxi);
            maxi = nums[i];
        }
     }
     reverse(nums.begin(),nums.end());
     return ans;
    }
};
